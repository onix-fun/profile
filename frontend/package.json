{
  "name": "@onix/profile-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync:design-system": "npm --prefix ../../onix-design-system run build",
    "predev": "npm run sync:design-system",
    "dev": "vite --host 0.0.0.0 --port 5175",
    "prebuild": "npm run sync:design-system",
    "build": "vue-tsc -b && vite build",
    "lint:ui": "node scripts/check-ui-contract.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4175",
    "pretest": "npm run sync:design-system",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@onix/design-system": "file:../../onix-design-system",
    "@primeuix/themes": "^2.0.3",
    "@tiptap/core": "3.28.0",
    "@tiptap/starter-kit": "3.28.0",
    "@tiptap/vue-3": "3.28.0",
    "axios": "^1.16.0",
    "pinia": "^3.0.4",
    "primevue": "^4.5.5",
    "vue": "^3.5.32",
    "vue-i18n": "^11.4.0",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^4.1.8",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.2.7"
  }
}
